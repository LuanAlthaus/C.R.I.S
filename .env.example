# Copia a .env.local (local) y carga las mismas en Vercel > Settings > Environment Variables.
# Nunca subas .env.local al repo.

# Supabase (Project Settings > API Keys, o botón "Connect")
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxxxxxx
# Solo servidor, NUNCA con prefijo NEXT_PUBLIC_. Úsala solo en scripts de carga de datos.
SUPABASE_SECRET_KEY=

# NASA Open APIs (gratis, instantánea): https://api.nasa.gov/  — sin ella se usa DEMO_KEY
NASA_API_KEY=

# NASA Earthdata Login (CMR, LP DAAC, ASF/NISAR, GES DISC): https://urs.earthdata.nasa.gov/
# Genera un token en tu perfil > "Generate Token"
EARTHDATA_TOKEN=

# NASA FIRMS (focos de calor MODIS/VIIRS): https://firms.modaps.eosdis.nasa.gov/api/map_key/
FIRMS_MAP_KEY=

# LLM opcional (elige uno; ver docs/resources/ofertas-y-free-tiers.md)
GEMINI_API_KEY=
GROQ_API_KEY=
